[Unit]
Description=usa-wa — nightly #302 dataset pipeline (harvests → dbt → registrar → publish) one-shot
Documentation=https://github.com/CannObserv/usa-wa/issues/311
# It ordered After the three canonical daily refreshes while they were the parity
# oracle. #412 PR E disabled them and retired the oracle probes: the chain reads
# only its own raw harvests, the registry and the operator events.
After=network-online.target postgresql.service usa-wa-migrate.service
Wants=network-online.target
# Alert on any counted stage failure (#49): harvest outage, registrar triage
# backlog, a dbt warning, publish-gate refusal, a probe failure — all exit 1 here.
OnFailure=usa-wa-notify-failure@%n.service

[Service]
Type=oneshot
User=exedev
WorkingDirectory=/home/exedev/usa-wa

# Refuse to start off a non-main checkout (#87).
ExecStartPre=/home/exedev/usa-wa/scripts/assert-main-checkout.sh

# Refuse to start against a venv whose editable installs resolve outside
# /home/exedev/usa-wa/packages/ (#279). A `uv run` in a worktree that shares this
# venv restamps them at .worktrees/<slug>/packages/…; the checkout stays on main,
# so the guard above passes and every import here fails once that worktree is
# gone — days later, reported as `Unable to configure formatter 'json'`.
ExecStartPre=/home/exedev/usa-wa/scripts/assert-venv-integrity.sh

# Pin PATH so `uv` resolves regardless of the inherited systemd default.
Environment=PATH=/usr/local/bin:/usr/bin:/bin

# App role only. The raw store, duckdb and dataset roots are the documented
# defaults under WorkingDirectory (docs/ENVIRONMENT.md), so no path env needed.
EnvironmentFile=/etc/usa-wa/.env
EnvironmentFile=-/home/exedev/usa-wa/.env

ExecStart=/home/exedev/usa-wa/scripts/pipeline-nightly.sh

# WSL fan-out (~60 paced SOAP calls) + full-archive dbt re-parse + publish;
# generous but bounded so a hung upstream fails deterministically.
TimeoutStartSec=1800
