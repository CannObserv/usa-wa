[Unit]
Description=usa-wa — PDC SODA ARCHIVE refresh (Phase A: winner cohorts) one-shot
# The Phase-A half of the daily PDC cycle (#201). Archives the current biennium's
# house-winners:<Y> + senate-winners:<Y> cohorts; usa-wa-pdc-refresh.service then re-drives
# the person_wa_pdc identifier links from that archive. It pulls this unit in (Wants=) and
# orders itself after it — deliberately weak: a Socrata outage alerts HERE and the rebuild
# still runs off the last good archive rather than being cancelled with it.
# usa-wa-migrate.service: schema must be at head before the DML-only archive runs.
# No WSL predecessor: this half only writes RawPayload/FetchEvent rows from the PDC wire.
After=network-online.target postgresql.service usa-wa-migrate.service
Wants=network-online.target
# Alert the operator on a failed/timed-out/degraded archive (#49). Exit 4 (EXIT_DEGRADED,
# every cohort unserved = a Socrata outage) is non-zero, so it fires this too.
OnFailure=usa-wa-notify-failure@%n.service

[Service]
Type=oneshot
User=exedev
WorkingDirectory=/home/exedev/usa-wa

# Refuse to start off a non-main checkout (#87): the enforcement behind the
# "main is the deployed code" convention, which #84 showed is not self-enforcing.
ExecStartPre=/home/exedev/usa-wa/scripts/assert-main-checkout.sh

# Pin PATH so `uv` resolves regardless of the inherited systemd default.
Environment=PATH=/usr/local/bin:/usr/bin:/bin

# App role only (DML — no DDL). USA_WA_PDC_APP_TOKEN (optional) raises Socrata's rate
# limit; absent is fine. USA_WA_BIENNIUM (optional) pins the biennium whose cohorts are
# archived. Later EnvironmentFiles override earlier ones.
EnvironmentFile=/etc/usa-wa/.env
EnvironmentFile=-/home/exedev/usa-wa/.env

# --frozen --no-sync: run against the installed venv as-is; never re-lock or sync
# at unit start (AGENTS.md § Server Lifecycle, #30).
ExecStart=/usr/local/bin/uv run --frozen --no-sync python -m usa_wa_adapter_pdc.archive_refresh

# Bound the PDC SODA GETs so a hung endpoint fails deterministically; the rebuild unit is
# ordered after this one, so its start waits on this bound too.
TimeoutStartSec=300

# This unit is pulled in by usa-wa-pdc-refresh.service (Wants=); no timer, no [Install].
