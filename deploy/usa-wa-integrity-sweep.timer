[Unit]
Description=usa-wa — weekly raw-store integrity sweep
Documentation=https://github.com/CannObserv/usa-wa/issues/412

[Timer]
# Weekly, Sunday 08:00 UTC. That overlaps the nightly pipeline's harvests
# (usa-wa-pipeline.timer, daily 08:00), which is safe: the store writes each
# object and each run manifest by tmp+replace, and a manifest only after its
# objects, so the sweep never sees a half-written run — a run still open is
# simply next week's. Corruption/tamper at rest is not time-sensitive to the
# hour; weekly bounds detection latency to ≤7 days with no manual action. The
# sweep writes only its cursor — a missed-then-caught run is safe.
OnCalendar=Sun *-*-* 08:00:00 UTC
# Run on next boot if the box was down at the scheduled time.
Persistent=true
# Jitter to avoid firing on the dot.
RandomizedDelaySec=300

[Install]
WantedBy=timers.target
