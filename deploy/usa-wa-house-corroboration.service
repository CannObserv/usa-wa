[Unit]
Description=usa-wa — House odd-year special-winner corroboration (#149) one-shot
# After the WSL + SOS refreshes so it reads the freshly-rebuilt open House Position cohort (WSL+SOS
# builder, driven by the SOS refresh) and the current results archive (SOS refresh archives the odd
# cohort). An odd-year House special winner with no open state_representative Position seat is a
# silent unseated member (the LD30/Hickel shape) — surfaced the morning after the wire re-drive.
# Ordering only — a failed/absent refresh must not wedge the timer. DB-only (no egress), so plain
# network.target.
After=network.target postgresql.service usa-wa-migrate.service usa-wa-wsl-refresh.service usa-wa-sos-refresh.service
# Alert the operator on a violation (#49/#149). This oneshot IS the anti-drift backstop for a
# missing House succession/backfill; a silent failure defeats it. %n → this unit's full name.
OnFailure=usa-wa-notify-failure@%n.service

[Service]
Type=oneshot
User=exedev
WorkingDirectory=/home/exedev/usa-wa

# Refuse to start off a non-main checkout (#87).
ExecStartPre=/home/exedev/usa-wa/scripts/assert-main-checkout.sh

# Pin PATH so `uv` resolves regardless of the inherited systemd default.
Environment=PATH=/usr/local/bin:/usr/bin:/bin

# App role — the corroboration is read-only (no citation half; the House Position spans already
# cite the odd wire in build.py). No owner token.
EnvironmentFile=/etc/usa-wa/.env
EnvironmentFile=-/home/exedev/usa-wa/.env

# --frozen --no-sync: run against the installed venv as-is (AGENTS.md § Server Lifecycle, #30).
# Exit 1 on a missing odd-year winner seat → the OnFailure handler emails the operator.
ExecStart=/usr/local/bin/uv run --frozen --no-sync python -m usa_wa_facts_seats.house_corroboration

# One winner-cohort scan; bound it so a stuck DB fails deterministically.
TimeoutStartSec=300

# This unit is started by usa-wa-house-corroboration.timer; no [Install] WantedBy.
