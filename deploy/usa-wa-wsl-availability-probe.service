[Unit]
Description=usa-wa — WSL next-biennium availability probe (#135: write-free, logs when 2027-28 answers) one-shot
Documentation=https://github.com/CannObserv/usa-wa/issues/135
# Measured, not assumed (#135 item 4): the 2027-01-01 rollover's nightly warnings last as long
# as WSL takes to publish 2027-28 — the chamber-vacancy warning until GetSponsors has rows, the
# WSL raw harvest's degraded run until GetCommittees stops faulting. This asks those operations
# (and each committee's GetCommitteeMembers) about 2027-28 once a day and appends the counts to
# data/research/wsl-availability.jsonl. Write-free: no raw store, no database, no ledger row.
# Egress to wslwebservices.leg.wa.gov, so network-online.
After=network-online.target
Wants=network-online.target
# The alert IS the product (#49, the roster re-check's convention, #237). Exit 4
# (EXIT_DEGRADED): a count changed state since the last measurement (faulting → empty → has
# rows; growth alone is logged, not mailed) — WSL started (or stopped) publishing 2027-28.
# Exit 1: an outage. Runbook: docs/RUNBOOK-ROLLOVER.md. %n → this unit.
OnFailure=usa-wa-notify-failure@%n.service

[Service]
Type=oneshot
User=exedev
WorkingDirectory=/home/exedev/usa-wa

# Refuse to start off a non-main checkout (#87): the enforcement behind the
# "main is the deployed code" convention, which #84 showed is not self-enforcing.
ExecStartPre=/home/exedev/usa-wa/scripts/assert-main-checkout.sh

# Refuse to start against a venv whose editable installs resolve outside
# /home/exedev/usa-wa/packages/ (#279).
ExecStartPre=/home/exedev/usa-wa/scripts/assert-venv-integrity.sh

# Pin PATH so `uv` resolves regardless of the inherited systemd default.
Environment=PATH=/usr/local/bin:/usr/bin:/bin

# No database is touched (needs_db=False). USA_WA_WSL_MIN_REQUEST_INTERVAL (optional, #77)
# spaces the SOAP requests through the central WSL limiter.
EnvironmentFile=/etc/usa-wa/.env
EnvironmentFile=-/home/exedev/usa-wa/.env

# --frozen --no-sync: run against the installed venv as-is (AGENTS.md § Server Lifecycle, #30).
# Every flag is load-bearing (pinned by scripts/tests/test_wsl_availability_unit.py):
#   --biennium 2027-28  the incoming biennium; the 2029 rollover edits this line.
#   --until 2027-02-28  the window: past it the probe asks nothing and exits 0, so ordinary
#                       mid-biennium committee churn never mails "news". Disable the timer then.
#   --log …             absolute, under data/ (git-ignored, beside the pipeline's outputs).
ExecStart=/usr/local/bin/uv run --frozen --no-sync python -m usa_wa_adapter_legislature.probe_availability --biennium 2027-28 --until 2027-02-28 --log /home/exedev/usa-wa/data/research/wsl-availability.jsonl

# Unpublished: two SOAP calls. Published: ~50 more, one per committee, through the limiter
# (18s for 2025-26's 34 committees on 2026-10-01). A hang past this fails into OnFailure=.
TimeoutStartSec=900

# This unit is started by usa-wa-wsl-availability-probe.timer; no [Install] WantedBy.
