[Unit]
Description=usa-wa — Washington State law, regulation, and policy tracking service
# usa-wa-migrate.service: schema must be at head before this DML-only app-role
# service serves. Redundant with migrate's reciprocal Before=, but declared here
# too for local discoverability. Ordering only — a failed/absent migrate must not
# wedge serving on an already-migrated box (no Wants=/Requires=).
After=network.target postgresql.service usa-wa-migrate.service
# Bound restart attempts so an off-main checkout — which fails the guard
# ExecStartPre below on every attempt — eventually settles into a visible
# `failed` state rather than an unbounded RestartSec=5 loop (#87 CR). Widened
# past systemd's default 10s window (which never trips at RestartSec=5) but kept
# generous so a transient dependency blip still self-heals via Restart=: gives
# up only after 10 failures across 5 min (#87 CR round 2). Invariant asserted in
# test_unit_ordering.py: StartLimitIntervalSec >= RestartSec * StartLimitBurst,
# so the burst can accumulate inside the window and the loop is provably bounded.
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=exedev
WorkingDirectory=/home/exedev/usa-wa

# Pin PATH so the guard's `git` (and `uv`) resolve regardless of the inherited
# systemd default — parity with the oneshot units.
Environment=PATH=/usr/local/bin:/usr/bin:/bin

# Refuse to start off a non-main checkout (#87): the enforcement behind the
# "main is the deployed code" convention, which #84 showed is not self-enforcing.
ExecStartPre=/home/exedev/usa-wa/scripts/assert-main-checkout.sh

# Refuse to start against a venv whose editable installs resolve outside
# /home/exedev/usa-wa/packages/ (#279). A `uv run` in a worktree that shares this
# venv restamps them at .worktrees/<slug>/packages/…; the checkout stays on main,
# so the guard above passes and every import here fails once that worktree is
# gone — days later, reported as `Unable to configure formatter 'json'`.
ExecStartPre=/home/exedev/usa-wa/scripts/assert-venv-integrity.sh

# Create runtime dir (runs as root before User= takes effect with + prefix)
ExecStartPre=+/bin/bash -c 'mkdir -p /run/usa-wa && chown exedev:exedev /run/usa-wa'

# Write current git SHA to a runtime env file before starting
ExecStartPre=/bin/bash -c 'echo BUILD_ID=$(git rev-parse --short HEAD) > /run/usa-wa/build-id'

# Load BUILD_ID, then system secrets, then optional repo-local overrides.
# Order matters: later EnvironmentFiles override earlier ones.
EnvironmentFile=-/run/usa-wa/build-id
EnvironmentFile=/etc/usa-wa/.env
EnvironmentFile=-/home/exedev/usa-wa/.env

# --frozen --no-sync: run against the installed venv as-is; never re-lock or
# sync at unit start. Dependency changes land only via a deliberate `uv sync`
# in the deploy runbook (AGENTS.md § Server Lifecycle, issue #30).
ExecStart=/usr/local/bin/uv run --frozen --no-sync uvicorn usa_wa_api.api.main:app --host 0.0.0.0 --port 8000 --log-config packages/usa-wa-api/src/usa_wa_api/log_config.json
Restart=on-failure
RestartSec=5

# Memory-pressure reservation (#389). The host is 7.7 GiB with NO swap, and an
# interactive agent session shares it with this service — the combination that
# took CannObserv/broker down for 57m on 2026-09-16 (gregoryfoster/skills#295).
# Two properties make the serving unit the victim rather than the cause:
#
#   1. Nothing separates them. Broker's report was that exe.dev session processes
#      inherit oom_score_adj -1000 and so can never be picked; measured HERE on
#      2026-09-19 that does not hold — exe-init reads 0 (only sshd reads -1000)
#      and session-launched servers inherit 0, the same adjustment this unit had.
#      Either way the kernel has no reason to prefer the cause over the service.
#   2. With no swap the kernel may kill nothing at all past the ceiling: it fails
#      atomic allocations in unrelated processes (tailscaled, ksoftirqd) while the
#      production service starves.
#
# MemoryLow protects this unit's pages from reclaim — a reservation, not a limit.
# Measured peak is ~62 MB, so 256M is headroom rather than a ceiling anywhere near
# live usage; systemd never refuses an allocation because of MemoryLow.
#
# IT IS HALF A MECHANISM. A cgroup's effective memory.low is capped by its
# ancestors', so this line reserves nothing unless system.slice holds protection
# for it to draw on — and system.slice defaults to 0. The other half is
# deploy/system.slice.d/10-usa-wa-memory.conf, which must be installed for this
# directive to do anything at all; test_memory_protection.py asserts the two stay
# in the right relation.
# OOMScoreAdjust moves it down the victim list. Measured on this host 2026-09-19:
# this unit read oom_score 668 while three concurrent SocratiCode MCP servers read
# 676-679 — cause and victim within noise of each other. -500 makes the gap
# decisive. (postgresql.service already ships at oom_score_adj -900 from the
# Debian packaging, so it needs no equivalent here.)
#
# Neither directive substitutes for the host-side half — vm.min_free_kbytes,
# earlyoom, and not installing an npm package per MCP session. All three are on
# this box; see docs/DEPLOYMENT-HOST.md § Memory pressure.
MemoryLow=256M
OOMScoreAdjust=-500

[Install]
WantedBy=multi-user.target
