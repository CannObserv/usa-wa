[Unit]
Description=usa-wa — committee lineage invariants (dissolved coherence + succession) one-shot (#124)
# After the daily refreshes + the committee-active reconcile so it checks the freshly
# rebuilt committee cohort. Ordering only — a failed/absent upstream must not wedge the
# timer. DB-only (no egress), so plain network.target.
After=network.target postgresql.service usa-wa-migrate.service usa-wa-wsl-refresh.service
# Alert the operator on a violation (#49/#124). A missing deactivation or succession
# attestation is silent; this oneshot IS the anti-drift backstop, so a silent failure
# defeats it. %n → this unit's full name.
OnFailure=usa-wa-notify-failure@%n.service

[Service]
Type=oneshot
User=exedev
WorkingDirectory=/home/exedev/usa-wa

# Refuse to start off a non-main checkout (#87).
ExecStartPre=/home/exedev/usa-wa/scripts/assert-main-checkout.sh

# Refuse to start against a venv whose editable installs resolve outside
# /home/exedev/usa-wa/packages/ (#279). A `uv run` in a worktree that shares this
# venv restamps them at .worktrees/<slug>/packages/…; the checkout stays on main,
# so the guard above passes and every import here fails once that worktree is
# gone — days later, reported as `Unable to configure formatter 'json'`.
ExecStartPre=/home/exedev/usa-wa/scripts/assert-venv-integrity.sh

# Pin PATH so `uv` resolves regardless of the inherited systemd default.
Environment=PATH=/usr/local/bin:/usr/bin:/bin

# App role only — read-only (SELECT on orgs/roles/assignments/succession); no writes.
EnvironmentFile=/etc/usa-wa/.env
EnvironmentFile=-/home/exedev/usa-wa/.env

# --frozen --no-sync: run against the installed venv as-is (AGENTS.md § Server Lifecycle, #30).
# Exit 1 on any invariant violation → the OnFailure handler emails the operator.
ExecStart=/usr/local/bin/uv run --frozen --no-sync python -m usa_wa_adapter_legislature.committees.lineage_invariants

# A few count queries; bound it so a stuck DB fails deterministically, timer retries next fire.
TimeoutStartSec=300

# This unit is started by usa-wa-committee-lineage-invariants.timer; no [Install] WantedBy.
