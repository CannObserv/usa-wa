# #497: the Tailscale origin is *follow*, scoped to what it was added for.
#
# patching-hosts' maintenance lane takes a followed origin by its site, and at
# apt's default 500 the site ties Ubuntu: a package it served under an Ubuntu
# name at a higher version would replace Ubuntu's. So the whole site sits at
# 100, and the client and its archive keyring at 600. Same file as
# CannObserv/replicator#131 (scripts/tests/test_tailscale_apt_pin.py).
#
# A .pref extension or none: apt ignores any other file in preferences.d.

Package: *
Pin: origin pkgs.tailscale.com
Pin-Priority: 100

Package: tailscale
Pin: origin pkgs.tailscale.com
Pin-Priority: 600

Package: tailscale-archive-keyring
Pin: origin pkgs.tailscale.com
Pin-Priority: 600
