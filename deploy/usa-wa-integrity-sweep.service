[Unit]
Description=usa-wa — raw-store integrity sweep (re-hash file objects vs their sha256 names, #304) one-shot
# Since #412 this sweeps the raw file store, not the Postgres RawPayload rows
# (#54): the store is what every published dataset is built from. The database
# is only the #178 ledger row, so usa-wa-migrate.service still orders it —
# ordering only, a failed/absent migrate must not wedge the timer on an
# already-migrated box. No egress, so plain network.target.
After=network.target postgresql.service usa-wa-migrate.service
# Alert the operator on failure (#49). A mismatch (exit 1 — corruption/tamper)
# on the weekly timer would otherwise wait ≤7 days to be seen; this sweep IS the
# at-rest tamper detector (#54), so a silent failure defeats its purpose. %n
# expands to this unit's full name (the notify handler's instance).
OnFailure=usa-wa-notify-failure@%n.service

[Service]
Type=oneshot
User=exedev
WorkingDirectory=/home/exedev/usa-wa

# Refuse to start off a non-main checkout (#87): the enforcement behind the
# "main is the deployed code" convention, which #84 showed is not self-enforcing.
ExecStartPre=/home/exedev/usa-wa/scripts/assert-main-checkout.sh

# Refuse to start against a venv whose editable installs resolve outside
# /home/exedev/usa-wa/packages/ (#279). A `uv run` in a worktree that shares this
# venv restamps them at .worktrees/<slug>/packages/…; the checkout stays on main,
# so the guard above passes and every import here fails once that worktree is
# gone — days later, reported as `Unable to configure formatter 'json'`.
ExecStartPre=/home/exedev/usa-wa/scripts/assert-venv-integrity.sh

# Pin PATH so `uv` resolves regardless of the inherited systemd default.
Environment=PATH=/usr/local/bin:/usr/bin:/bin

# App role only: DATABASE_URL carries the ledger row. USA_WA_RAW_ROOT names the
# store; unset, it is raw/ under WorkingDirectory — the same store the nightly
# harvests write. Its one write is the rolling cursor at
# <root>/.raw_integrity_state.json. Later EnvironmentFiles override earlier ones.
EnvironmentFile=/etc/usa-wa/.env
EnvironmentFile=-/home/exedev/usa-wa/.env

# --frozen --no-sync: run against the installed venv as-is; never re-lock or sync
# at unit start (AGENTS.md § Server Lifecycle, #30).
ExecStart=/usr/local/bin/uv run --frozen --no-sync python -m clearinghouse_core.raw_integrity

# Backstop the bounded rolling slice (#55 idiom, default 256 MiB) so a stuck
# disk fails deterministically rather than hanging the manager; the timer
# retries next fire. The per-run byte budget keeps a routine run far inside this.
TimeoutStartSec=600

# This unit is started by usa-wa-integrity-sweep.timer; no [Install] WantedBy.
